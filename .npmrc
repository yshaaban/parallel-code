# This project installs with npm (see package-lock.json).
#
# npm 11.17+ blocks unreviewed dependency install scripts in strict mode. Keep this enabled so a
# lock refresh cannot silently skip or introduce native/build lifecycle code; exact approvals live
# in package.json's allowScripts map. `onlyBuiltDependencies` is pnpm-specific and does not belong
# in this npm-owned configuration.
strict-allow-scripts=true

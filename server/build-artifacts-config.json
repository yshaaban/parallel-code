{
  "ignoredSourceDirs": [
    ".git",
    ".playwright-browser-lab",
    ".sentrux",
    "dist",
    "dist-browser-dev",
    "dist-remote",
    "dist-remote-dev",
    "dist-server",
    "node_modules",
    "release",
    "test-results"
  ],
  "ignoredSourceFilePatterns": [
    "\\.spec\\.[cm]?[jt]sx?$",
    "\\.test\\.[cm]?[jt]sx?$",
    "\\.test-helper\\.[cm]?[jt]sx?$",
    "\\.benchmark\\.[cm]?[jt]sx?$"
  ],
  "checks": {
    "frontend": {
      "artifactRelativePath": "dist/index.html",
      "metadataRelativePath": "dist/build-metadata.json",
      "sourceRelativePaths": [
        "src",
        "index.html",
        "electron/ipc/channels.ts",
        "electron/remote/protocol.ts",
        "electron/vite.config.electron.ts",
        "tsconfig.json",
        "package-lock.json"
      ],
      "versionSourceRelativePath": "package.json"
    },
    "remote": {
      "artifactRelativePath": "dist-remote/index.html",
      "sourceRelativePaths": [
        "src/remote",
        "src/domain",
        "src/lib",
        "src/store/server-state-versioning.ts",
        "electron/ipc/channels.ts",
        "electron/remote",
        "src/remote/vite.config.ts",
        "package-lock.json"
      ]
    },
    "server": {
      "artifactRelativePath": "dist-server/server/main.js",
      "sourceRelativePaths": [
        "server",
        "electron/coordinator",
        "electron/ipc",
        "electron/remote",
        "electron/log.ts",
        "electron/runtime-cleanup.ts",
        "electron/stdio.ts",
        "electron/user-shell.ts",
        "src/arena/command-template.ts",
        "src/ipc",
        "src/domain",
        "src/lib",
        "src/store/browser-cold-bootstrap-projection-types.ts",
        "src/store/persistence-agent-defaults.ts",
        "src/store/persistence-legacy-state.ts",
        "src/store/persistence-load-context.ts",
        "src/store/persistence-projects.ts",
        "src/store/persistence-task-hydration.ts",
        "src/store/project-mode.ts",
        "src/store/task-agent-selection.ts",
        "src/store/task-git-isolation.ts",
        "src/store/types.ts",
        "src/terminal-core/terminal-ordering.ts",
        "tsconfig.json",
        "server/tsconfig.json",
        "package-lock.json"
      ]
    }
  }
}

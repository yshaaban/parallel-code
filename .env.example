# Parallel Code — Environment Variables
# Copy this file to .env and customize as needed.

# Server mode (npm run server / npm run browser:dev)
PORT=43117
# Stable local-development token. Change before exposing the server beyond local development.
AUTH_TOKEN=parallel-code-local-browser

# Optional scoped remote/mobile HTTPS mode. Configure all four transport/trust
# values together; the private key must not be accessible by group/other users.
# PARALLEL_CODE_REMOTE_TLS_CERT_PATH=
# PARALLEL_CODE_REMOTE_TLS_KEY_PATH=
# PARALLEL_CODE_REMOTE_TRUSTED_INTERFACES=tailscale0
# PARALLEL_CODE_REMOTE_TRUSTED_PEER_RANGES=100.64.0.0/10
# Optional grant set and stable share token. When omitted, the scoped surface is
# read-only: catalog:read,terminal:read. Write grants are deliberately separate:
# task:create permits managed tasks; task:create-root permits project-root tasks;
# task:create-imported permits existing-worktree tasks; task:permission-bypass
# permits agent permission bypass; notes:read/notes:write and terminal:control
# independently enable those effects. A fresh remote token is generated at startup.
# The remote token must be different from AUTH_TOKEN.
# PARALLEL_CODE_REMOTE_GRANTS=catalog:read,terminal:read
# PARALLEL_CODE_REMOTE_ACCESS_TOKEN=

# Data directory for server mode (defaults to .server-data/)
# PARALLEL_CODE_USER_DATA_DIR=
# Optional static artifact roots. browser:dev sets these to dist-browser-dev/ and
# dist-remote-dev/ so watch builds do not mutate production/test artifacts.
# PARALLEL_CODE_BROWSER_DIST_DIR=
# PARALLEL_CODE_BROWSER_DIST_REMOTE_DIR=

# Latency simulation (development/testing only)
# SIMULATE_LATENCY_MS=0
# SIMULATE_JITTER_MS=0
# SIMULATE_PACKET_LOSS=0
# For docker-compose SSH agent forwarding, set this to your host ssh-agent socket path.
# Use the real socket path here. Compose does not expand nested values like
# HOST_SSH_AUTH_SOCK=$SSH_AUTH_SOCK inside .env.
# Linux example: HOST_SSH_AUTH_SOCK=/run/user/1000/keyring/ssh
# macOS example: HOST_SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock
# HOST_SSH_AUTH_SOCK=
